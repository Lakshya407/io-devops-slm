# IO Coding Agent — environment template.
#
# Copy this file to `.env` and replace every "change-me" value. Never commit
# the real `.env`. The deployment scripts can generate the random values for
# you (see scripts/deploy.sh).
#
# This file is for the io-agent Compose project only. Do not merge it into the
# existing LiteLLM `.env`.

# --- Host paths ---------------------------------------------------------
# Root for bind-mounted workspaces, repositories and dataset exports.
IO_AGENT_HOST_ROOT=/srv/io-agent
# Loopback-only API port on the VM.
IO_AGENT_PORT=8091

# --- Model access -------------------------------------------------------
# Any LiteLLM model alias can be used. The default is the local Qwen coder.
AGENT_MODEL=qwen2.5-coder:1.5b
# Model id shown to Open WebUI.
AGENT_PUBLIC_MODEL_ID=io-coding-agent
LITELLM_BASE_URL=http://litellm:4000/v1
# Dedicated, least-privilege LiteLLM virtual key. Generate with
# scripts/create_litellm_key.sh. Never use the LiteLLM master key here.
LITELLM_API_KEY=change-me-litellm-virtual-key
AGENT_LLM_TIMEOUT_SECONDS=300
AGENT_MODEL_NUM_CTX=8192
# Set to false only when the model is a cloud provider. Code context is then
# blocked unless AGENT_ALLOW_CLOUD_CODE_CONTEXT=true.
AGENT_MODEL_IS_LOCAL=true
AGENT_ALLOW_CLOUD_CODE_CONTEXT=false

# --- Public API authentication -----------------------------------------
# Long random value shared with Open WebUI. Generate with:
#   openssl rand -hex 32
AGENT_API_KEY=change-me-agent-api-key
# Only enable if a trusted reverse proxy strips client-supplied identity
# headers and injects its own.
AGENT_TRUST_FORWARDED_USER=false

# --- Persistence --------------------------------------------------------
# Dedicated database. Create it with scripts/bootstrap_db.sh.
AGENT_DATABASE_URL=postgresql+psycopg://io_agent:change-me-db-password@postgres:5432/io_agent

# --- Sandbox ------------------------------------------------------------
# Shared secret between the agent and the sandbox runner. Generate with:
#   openssl rand -hex 32
SANDBOX_TOKEN=change-me-sandbox-token
AGENT_SANDBOX_URL=http://sandbox-runner:8090
AGENT_SANDBOX_IMAGE=io-agent-sandbox:latest
AGENT_COMMAND_TIMEOUT_SECONDS=300
AGENT_MAX_OUTPUT_BYTES=200000
# Milestone 1 keeps these disabled. They return explicit disabled stubs.
AGENT_ENABLE_DOCKER_BUILD=false
AGENT_ENABLE_KUBERNETES=false

# --- Workspaces ---------------------------------------------------------
AGENT_WORKSPACES_DIR=/workspaces
AGENT_REPOS_DIR=/repos
AGENT_MAX_REPO_SIZE_MB=200
AGENT_ALLOW_ANY_HTTPS_REPO=true
# Comma-separated host allowlist, e.g. iogitlab.infoorigin.com
AGENT_REPO_ALLOWLIST=
AGENT_ALLOW_INSECURE_HTTP=false
AGENT_CLONE_TIMEOUT_SECONDS=300
# Refuse test edits when the task is "fix the failing test".
AGENT_PROTECT_TESTS=true

# --- Agent loop ---------------------------------------------------------
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_REPAIRS=2
AGENT_MAX_INSPECT_STEPS=3
AGENT_MAX_CONTEXT_FILES=6
AGENT_MAX_FILE_BYTES=200000
AGENT_MAX_PROMPT_FILE_CHARS=24000
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_MAX_CONCURRENT_TASKS=2

# --- Operations ---------------------------------------------------------
AGENT_LOG_LEVEL=INFO
# Store only truncated tool output by default.
AGENT_STORE_RAW_OUTPUT=false
AGENT_DATASET_EXPORT_DIR=/exports
AGENT_APPROVAL_TTL_MINUTES=60

# --- Optional InfoOrigin integrations -----------------------------------
# Leave empty for Milestone 1. Adapters return "not_configured" and never
# invent endpoint paths or make requests.
IOPROJECTS_BASE_URL=
IOPROJECTS_TOKEN=
IOGITLAB_BASE_URL=
IOGITLAB_TOKEN=
IOAGRCO_BASE_URL=
IOAGRCO_TOKEN=
IOARTIFACTORY_BASE_URL=
IOARTIFACTORY_TOKEN=
IODB_BASE_URL=
IODB_TOKEN=
